# ==============================================================
# Konfigurasi Environment Backend Boson Studio (Supabase Self-Hosted)
# ==============================================================

# 1. Kredensial Database PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=GantiPasswordPostgresYangSangatKuatDanPanjang123!

# 2. Keamanan JWT (Minimal 32 karakter acak)
JWT_SECRET=super_secret_boson_jwt_signing_key_32_characters_min!
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_generated_anon_key_here
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_generated_service_role_key_here

# 3. URL Publik Backend Anda (Ganti dengan domain VPS Anda, misal https://api.boson.id)
PLATFORM_PUBLIC_URL=https://api.boson.id
API_EXTERNAL_URL=https://api.boson.id
SITE_URL=https://app.boson.id

# 4. Port Layanan Lokal
GATEWAY_PORT=8080
STUDIO_PORT=3001

# 5. Master API Key Provider LLM (DeepSeek)
# Kunci rahasia milik Anda yang digunakan untuk memanggil model atas nama seluruh user berbayar
DEEPSEEK_MASTER_KEY=sk-your-deepseek-master-api-key-here
DEEPSEEK_UPSTREAM=https://api.deepseek.com
